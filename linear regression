import pandas as pd
from sklearn.datasets import fetch_california_housing
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error, r2_score
from sklearn.model_selection import train_test_split

# Automatically fetches the California Housing dataset (no CSV upload needed)
data = fetch_california_housing(as_frame=True)
df = data.frame

# Simple Linear Regression
X_simple = df[['MedInc']]
y = df['MedHouseVal']

X_s_train, X_s_test, y_s_train, y_s_test = train_test_split(
    X_simple, y, test_size=0.2, random_state=42
)
simple_model = LinearRegression()
simple_model.fit(X_s_train, y_s_train)
y_s_pred = simple_model.predict(X_s_test)

print('--- Simple Linear Regression ---')
print(f'R2 Score: {r2_score(y_s_test, y_s_pred):.4f}')

# Multiple Linear Regression
X_multi = df.drop(columns=['MedHouseVal'])
X_m_train, X_m_test, y_m_train, y_m_test = train_test_split(
    X_multi, y, test_size=0.2, random_state=42
)
multi_model = LinearRegression()
multi_model.fit(X_m_train, y_m_train)
y_m_pred = multi_model.predict(X_m_test)

print('--- Multiple Linear Regression ---')
print(f'R2 Score: {r2_score(y_m_test, y_m_pred):.4f}')
